# Unity 프로젝트 루트용 .gitignore (github/gitignore의 Unity 템플릿 기반)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# 무시된 에셋의 meta가 아니라면 meta 파일은 항상 커밋
!/[Aa]ssets/**/*.meta

# Rider 플러그인 자동 생성 파일
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE 캐시와 자동 생성 솔루션/프로젝트 파일
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

crashlytics-build.properties

# Addressables 빌드 결과
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
